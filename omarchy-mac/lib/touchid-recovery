#!/bin/bash
# Passive report for the Touch ID configuration transition. It reads diag
# attributes and whether the node exists, and it never opens the node.
node=${OMARCHY_MAC_TOUCHID_NODE:-/dev/sep-bio}
driver=${OMARCHY_MAC_TOUCHID_DRIVER:-/sys/bus/platform/drivers/apple_sep}
omarchy-hw-apple-silicon || exit 0

attribute() {
  local file
  for file in "$driver"/*/diag/"$1"; do
    if [[ -r $file ]]; then
      tr -d '\n' <"$file"
      return 0
    fi
  done
  return 1
}

token() {
  local value
  if value=$(attribute "$1") && [[ $value =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf '%s' "$value"
  fi
}

keystore=$(token keystore)
keybag=$(token keybag)
if [[ $keystore == "open" && $keybag == "present" ]]; then
  host_store=ready
elif [[ -n $keystore ]]; then
  host_store=$keystore
else
  host_store=missing
fi

xart=$(token xart)
sensor=$(token sensor)
touchid=$(token touchid)
sensor_attach=$(token sensor_attach)
restore=$(token restore)
matching=$(token matching)
refusals_text=$(token xart_guard_refusals)
if [[ $refusals_text =~ ^[0-9]+$ ]]; then
  refusals=$refusals_text
else
  refusals=-1
fi

if [[ -e $node && ! -L $node ]]; then
  node_present=true
else
  node_present=false
fi

ready=false
if [[ $node_present == "true" && $host_store == "ready" && $xart == "enabled" && $sensor == "online" && $touchid == "ready" && $sensor_attach == "attached" && $refusals == "0" ]]; then
  if [[ $restore == "restored" || $restore == "empty" ]]; then
    if [[ $matching == "usable" || $matching == "unverified" ]]; then
      ready=true
    fi
  fi
fi
if [[ $ready == "true" ]]; then
  action=ready-for-test
elif [[ $touchid == "unknown" ]]; then
  action=setup
else
  action=unsupported
fi

printf '{"action":"%s","node_present":%s,"facts":{"host_store":"%s","xart":"%s","sensor":"%s","touchid":"%s","sensor_attach":"%s","restore":"%s","matching":"%s","refusals":%s}}\n' \
  "$action" "$node_present" "$host_store" "$xart" "$sensor" "$touchid" "$sensor_attach" "$restore" "$matching" "$refusals"
